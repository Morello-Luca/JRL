<?xml version="1.0" ?>
<robot name="my_box">
	<link name="my_box">
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<mass value="0.1"/>
			<inertia ixx="1" ixy="0" ixz="0"
			iyy="1" iyz="0"
			izz="1" />
		</inertial>
		<visual>
			<geometry>
				<mesh filename="../meshes/box/my_box.stl"/>
			</geometry>
			<material name="CardBoard">
				<color rgba="1 0 0 1" />
			</material>
		</visual>

	</link>
</robot>
